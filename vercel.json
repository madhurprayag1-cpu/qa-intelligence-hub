{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend,domains,qa-engine,ai-engine}/**"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/airlines(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/airports(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/flights(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/search/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/bookings(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/orders(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/ancillaries(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/payments(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/ai/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/defects(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/quality-gate/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/qa/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/healthcare(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/fintech(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/ecommerce(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/telecom(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
